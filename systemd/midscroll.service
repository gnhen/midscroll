[Unit]
Description=midscroll - Windows-style middle-drag autoscroll
# uinput is normally autoloaded; where it isn't, let systemd load it rather
# than running modprobe ourselves, so this service can drop every capability
# and forbid module loading outright (see CapabilityBoundingSet below).
Wants=modprobe@uinput.service
After=modprobe@uinput.service

[Service]
ExecStart=/usr/bin/python3 /usr/bin/midscroll
# Holds the state socket the session overlay (midscroll-overlay) listens on
RuntimeDirectory=midscroll
Restart=always
RestartSec=2
# Mouse events pass through this process; make sure it's never starved.
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=20

# Sandboxing. The daemon needs only /dev/input, /dev/uinput, the config in
# /etc and its runtime dir. ProtectSystem=strict leaves /dev, /proc and
# /sys writable, and RuntimeDirectory= is implicitly writable, so the
# socket and devices keep working. Deliberately absent because they would
# break the daemon: PrivateDevices/DevicePolicy (needs real evdev+uinput
# nodes, including ones hotplugged later), RestrictRealtime (FIFO
# scheduling above), PrivateUsers (the device nodes are root's).
NoNewPrivileges=yes
# It runs as root for the device nodes, but wants no capability at all:
# opening /dev/input and /dev/uinput, EVIOCGRAB and uinput ioctls are all
# plain DAC, and the FIFO priority above is set by PID 1 before exec.
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
# The state socket verifies the peer executable through /proc/<pid>/cmdline.
# Hiding other users' processes would make legitimate session overlays fail
# closed and disable focus reporting.
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
# Containment for the state socket, which every logged-in user can reach:
# the daemon caps clients itself, and these cap what a bug could cost.
MemoryMax=128M
TasksMax=32
# Allow only the service syscall set and fail the rest with EPERM rather
# than SIGSYS. @system-service already excludes @resources, @privileged,
# @module, @mount and friends, and still includes ioctl (EVIOCGRAB + uinput)
# and epoll, so grabbing and asyncio keep working. FIFO scheduling is set by
# systemd before exec, so no realtime syscall is needed here.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Pure CPython, no JIT, so it never needs writable-executable memory.
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
